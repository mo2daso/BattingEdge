# ===========================
# 7. MODELS (SELECTIVE)
# ===========================
# Ignore heavy neural network weights everywhere EXCEPT our V9.5 models
*.keras
*.h5
*.pt
*.pth
*.ckpt
*.onnx
backend/models/checkpoints/

# EXCEPTION: Keep V9.5 model files (safe for GitHub — all under 10MB)
!backend/models/battingedge_V9_5_best.keras
!backend/models/*.pkl
!backend/models/*.json
!backend/models/scaler_V9_5.pkl
!backend/models/classes_V9_5.pkl

# V10 RF is 132MB — too large for GitHub, block explicitly
backend/models/battingedge_V10_random_forest_best.pkl

# Keep YOLO out (large)
yolov8n.pt
notebooks/yolov8n.pt
backend/models/yolov8n.pt
backend/yolov8n.pt

# Specific YOLO model files (too large)
yolov8n.pt
