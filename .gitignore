# ===========================
# BATTING EDGE - GIT IGNORE
# ===========================

# --- 1. System & Python Garbage ---
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints
venv/
.env
.vscode/
.idea/
.DS_Store

# --- 2. Heavy Data & Features (CRITICAL) ---
# We keep the folder structure, but ignore the contents
data/features/
data/dataset_*/
# Ignore all numpy arrays anywhere in the project
*.npy
*.npz

# --- 3. Video Assets ---
# Ignore raw testing clips (Local only)
data/raw_test_clips/
data/unprofvids/
# Ignore generated demo outputs
data/demo_outputs/
data/defense_demos/
# Ignore all video formats to prevent accidental uploads
*.mp4
*.avi
*.mov
*.mkv

# --- 4. Logs & Reports ---
logs/
*.log
# Ignore temporary audit files if you forgot to delete them
FULL_DEEP_AUDIT_REPORT.json
project_inventory.json
COMPLETE MASTER PLAN.pdf

# --- 5. Models (Selective) ---
# We WANT to upload your final V8p models because they are small (<100MB).
# But we IGNORE intermediate checkpoints or huge training buffers.
backend/models/checkpoints/
*.h5

# --- 6. Archives ---
archive/
*.zip
*.rar