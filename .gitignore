# ===========================
# 1. PYTHON & SYSTEM GARBAGE
# ===========================
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints
venv/
.env
.vscode/
.idea/
.DS_Store
Thumbs.db

# ===========================
# 2. FRONTEND (REACT/NODE)
# ===========================
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.eslintcache
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*

# ===========================
# 3. BACKEND DATA & LOGS
# ===========================
# User uploads and generated outputs should stay local
backend/uploads/
backend/outputs/
# Local Database
backend/shot_analysis.db
*.sqlite3
# Logs
logs/
*.log

# ===========================
# 4. HEAVY DATASETS & FEATURES
# ===========================
# Ignore the raw training data and extracted features
data/dataset_*/
data/features/
data/raw_test_clips/
data/unprofvids/
data/unprofessional_test/

# ===========================
# 5. GENERATED DEMOS
# ===========================
# Ignore the output videos generated for defense
data/demo_outputs/
data/defense_demos/
data/demo_videos/

# ===========================
# 6. GLOBAL FILE BANS (HEAVY)
# ===========================
# Block all videos and heavy arrays everywhere
*.mp4
*.avi
*.mov
*.mkv
*.npy
*.npz
*.zip
*.rar

# ===========================
# 7. MODELS (SELECTIVE)
# ===========================
# Ignore heavy Neural Network weights (>100MB usually)
backend/models/*.keras
backend/models/*.h5
backend/models/*.pt
backend/models/checkpoints/

# !IMPORTANT! KEEP these tiny files required for the logic to run:
!backend/models/*.pkl
!backend/models/*.json