# ===========================
# 1. PYTHON & SYSTEM GARBAGE
# ===========================
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints
venv/
env/
.env
.env.local
.vscode/
.idea/
.DS_Store
Thumbs.db

# ===========================
# 2. FRONTEND (REACT/NODE)
# ===========================
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.eslintcache
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*

# ===========================
# 3. BACKEND DATA & LOGS
# ===========================
# User uploads and generated outputs should stay local
backend/uploads/
backend/outputs/
# Local Database
backend/shot_analysis.db
battingedge.db
*.sqlite
*.sqlite3
*.db
# Logs
logs/
*.log

# ===========================
# 4. HEAVY DATASETS & FEATURES
# ===========================
# Ignore the raw training data and extracted features
data/dataset_*/
data/features/
data/raw_test_clips/
data/unprofvids/
data/unprofessional_test/
# CRITICAL: Ignore features folder with training arrays
features/
*.npy
*.npz

# ===========================
# 5. GENERATED DEMOS
# ===========================
# Ignore the output videos generated for defense
data/demo_outputs/
data/defense_demos/
data/demo_videos/

# ===========================
# 6. GLOBAL FILE BANS (HEAVY)
# ===========================
# Block all videos and heavy arrays everywhere
*.mp4
*.avi
*.mov
*.mkv
*.webm
*.flv
*.wmv
*.zip
*.rar
*.tar.gz
*.7z

# ===========================
# 7. MODELS (SELECTIVE)
# ===========================
# Ignore heavy Neural Network weights
*.keras
*.h5
*.pt
*.pth
*.ckpt
*.onnx
backend/models/checkpoints/

# EXCEPTION: Keep small pickle files and configs
!backend/models/*.pkl
!backend/models/*.json
!backend/models/scaler_*.npy

# Specific YOLO model files (too large)
yolov8n.pt
notebooks/yolov8n.pt
backend/models/yolov8n.pt

# ===========================
# 8. DOCUMENTATION (OPTIONAL)
# ===========================
# Uncomment if you have large PDF datasets
 *.pdf
# But allow small docs in docs folder:
!docs/*.pdf